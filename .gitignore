# ---------------------------------------------------------------------------
# DevEco Studio / HarmonyOS (baseline, generated by the IDE template)
# ---------------------------------------------------------------------------
/node_modules
/oh_modules
/local.properties
/.idea
**/build
/.hvigor
.cxx
/.clangd
/.clang-format
/.clang-tidy
**/.test
/.appanalyzer
/.codegenie

# ---------------------------------------------------------------------------
# Build artifacts of the native proxy core (see scripts/build-core.sh).
# The core is produced from source at build time and is NEVER committed:
# a ~32 MB .so per ABI would bloat every clone, and it embeds GPL/MPL code.
# ---------------------------------------------------------------------------
/entry/libs/**/*.so
/entry/libs/**/*.so.*
!/entry/libs/**/.gitkeep

# HAP / HSP packages produced by hvigor
*.hap
*.hsp
*.har

# Local signing material -- NEVER commit certificates or private keys.
# See docs/03-环境搭建.md ("签名与证书") for how each developer configures this.
/signature/
*.p12
*.cer
*.p7b
*.keystore
*.jks
/build-profile.local.json5

# Local-only overrides and throwaway scratch space
*.local.json5
/tmp/
/scratch/

# Staging directory of scripts/release-local.ps1. It holds a renamed copy of the
# unsigned HAP plus SHA256SUMS.txt -- build outputs, and this repository never
# tracks build outputs (AGENT.md section 1: "不提交任何构建产物").
/release-out/

# Editor / OS noise
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
*.swp

# ---------------------------------------------------------------------------
# Exception: third-party reference submodules have their own repositories.
# ---------------------------------------------------------------------------
!third_party/
