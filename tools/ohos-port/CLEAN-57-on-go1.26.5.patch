+}
+
+int x_cgo_get_environ(char ***env_ptr) {
+	if (env_ptr == NULL) {
+		return -1;
+	}
+	if (!environ) {
+		return -1;
+	}
+	*env_ptr = environ;
+	return 0;
+}
