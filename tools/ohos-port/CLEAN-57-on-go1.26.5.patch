diff --git a/src/bootstrap.bash b/src/bootstrap.bash
index 5a97d52e..12167a83 100755
--- a/src/bootstrap.bash
+++ b/src/bootstrap.bash
@@ -74,6 +74,13 @@ else
 	rm -rf "pkg/${gohostos}_${gohostarch}" "pkg/tool/${gohostos}_${gohostarch}"
 fi
 
+if ! command -v binary-sign-tool >/dev/null 2>&1; then
+  echo "warning: binary-sign-tool not found, check your toolchain." >&2
+else
+  find pkg/tool/${goos}_${goarch} bin -type f -exec \
+  binary-sign-tool sign -inFile {} -outFile {} -selfSign "1" > /dev/null \;
+fi
+
 rm -rf pkg/bootstrap pkg/obj .git
 
 echo ----
