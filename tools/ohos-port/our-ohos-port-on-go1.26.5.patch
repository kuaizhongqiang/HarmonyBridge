+	if GOARCH == "arm64" && IsOpenharmony {
+		if HeapAddrBits != 39 {
+			t.Fatalf("heapAddrBits = %d, want 39", HeapAddrBits)
+		}
+	} else if (GOARCH == "amd64" || GOARCH == "arm64") && GOOS == "linux" {
+		if HeapAddrBits != 48 {
+			t.Fatalf("heapAddrBits = %d, want 48", HeapAddrBits)
+		}
+	} else {
+		t.Skip()
+	}
+}
