{
  // ---------------------------------------------------------------------------
  // ArkTS code linter configuration (DevEco Studio Code Linter / codelinter).
  //
  // Schema is the one shipped with the DevEco Studio project template -- keys:
  // files / ignore / ruleSet / rules. Do not invent keys here: an unknown key
  // makes the linter fail to load the file, which silently disables linting.
  //
  // Full rule sets available from D:\...\DevEco Studio\plugins\codelinter:
  //   plugin:@performance/{all,recommended}
  //   plugin:@typescript-eslint/{all,recommended}
  //   plugin:@security/{all,recommended}
  //   plugin:@correctness/all
  //   plugin:@compatibility/all
  //   plugin:@cross-device-app-dev/{all,recommended}
  //   plugin:@private/{all,recommended}
  //   plugin:@hw-stylistic/{all,recommended}
  //   plugin:@previewer/{all,recommended}
  //
  // Severity legend used by the rule-set definitions: "off" | "warn" | "error"
  // (the plugin JSON files use the numeric 0/1/2 forms).
  // ---------------------------------------------------------------------------
  "files": [
    "**/*.ets"
  ],
  "ignore": [
    // --- Test / mock sources: not shipped, and the templates intentionally use
    // patterns the production rules dislike. Kept from the DevEco template.
    "**/src/ohosTest/**/*",
    "**/src/test/**/*",
    "**/src/mock/**/*",

    // --- Dependencies and generated output. Nothing here is ours to fix, and
    // linting it wastes the whole run.
    "**/node_modules/**/*",
    "**/oh_modules/**/*",
    "**/build/**/*",
    "**/.preview/**/*",
    "**/.cxx/**/*",
    "**/.hvigor/**/*",

    // --- Generated by hvigor; regenerated on every build.
    "**/BuildProfile.ets",
    "**/oh-package-lock.json5",

    // --- hvigor build scripts are Node/TypeScript, not ArkTS. They are also
    // owned by the build tooling, not by application code.
    "**/hvigorfile.ts",
    "**/hvigorfile.js",

    // --- Read-only reference submodule (GPL-3.0). Its style is its own; see
    // CONTRIBUTING.md -> "许可证与第三方代码". Never lint, never reformat.
    "**/third_party/**/*",

    // --- Vendored native prebuilts: binaries, not source.
    "**/*.so",
    "**/*.a",
    "**/*.dll",
    "**/*.dylib"
  ],
  "ruleSet": [
    "plugin:@performance/recommended",
    "plugin:@typescript-eslint/recommended",
    // Adds only @security/no-commented-code (warn); cheap and relevant for a
    // proxy client, which is full of commented-out endpoints and diagnostics.
    "plugin:@security/recommended"
  ],
  "rules": {
    // --- Crypto misuse. These are errors, not warnings: this app stores proxy
    // credentials and handles the tunnel's key material, so a weak primitive is
    // a real defect, not a style preference. Same set as the DevEco template.
    "@security/no-unsafe-aes": "error",
    "@security/no-unsafe-hash": "error",
    "@security/no-unsafe-mac": "warn",
    "@security/no-unsafe-dh": "error",
    "@security/no-unsafe-dsa": "error",
    "@security/no-unsafe-ecdsa": "error",
    "@security/no-unsafe-rsa-encrypt": "error",
    "@security/no-unsafe-rsa-sign": "error",
    "@security/no-unsafe-rsa-key": "error",
    "@security/no-unsafe-dsa-key": "error",
    "@security/no-unsafe-dh-key": "error",
    "@security/no-unsafe-3des": "error",

    // --- Correctness rules the recommended sets leave out but that matter for
    // an app whose whole job is to open a tunnel and then stay quiet:
    //   * a leaked timer/observer keeps the VPN service alive after "disconnect";
    //   * a floating promise swallows a failed connection silently.
    "@typescript-eslint/no-floating-promises": "error",
    "@typescript-eslint/no-misused-promises": "error",
    "@typescript-eslint/require-await": "warn",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],

    // --- Deliberately demoted. The ArkTS/HarmonyOS SDK surface is largely
    // untyped at the boundary (JSON.parse of a subscription, dynamic module
    // imports, `napi` returns), so `any` leaks are unavoidable in the adapter
    // layer. Keeping them as errors would train people to blanket-disable the
    // rule; a warning still shows up in review.
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/no-unsafe-assignment": "warn",
    "@typescript-eslint/no-unsafe-member-access": "warn",
    "@typescript-eslint/no-unsafe-argument": "warn",
    "@typescript-eslint/no-unsafe-call": "warn",
    "@typescript-eslint/no-unsafe-return": "warn"
  },
  "overrides": [
    {
      // Previewer / tooling entry points that the SDK injects: `onWindowStageCreate`
      // and friends are called by the framework, so the "must be async" and
      // "no floating promise" family produces nothing but noise here.
      "files": [
        "**/entryability/**/*.ets",
        "**/entrybackupability/**/*.ets"
      ],
      "rules": {
        "@typescript-eslint/no-floating-promises": "warn",
        "@typescript-eslint/require-await": "off"
      }
    }
  ]
}
